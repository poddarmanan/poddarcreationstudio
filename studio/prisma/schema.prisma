// Poddar Creation Studio — data model
// Ported from the approved Claude Design prototype (fabric/colour system, swatch book,
// quotes) plus the real backend the user asked for on top of it (auth, uploads/pipeline).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  SALES
  VIEWER
  BUYER
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UploadJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// Upload queue (Priority 11). The original file is stored before processing, so FAILED
/// jobs can be retried without re-uploading.
model UploadJob {
  id          String          @id @default(cuid())
  fabricId    String
  colourId    String?
  fileName    String
  mimeType    String
  sizeBytes   Int
  originalKey String
  status      UploadJobStatus @default(PENDING)
  attempts    Int             @default(0)
  error       String?
  mediaId     String?
  actorId     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, createdAt])
}

enum MediaStage {
  QUEUED
  COMPRESSING
  NAMING
  THUMBNAIL
  QR
  PUBLISHED
}

/// Immutable record of privileged / state-changing actions (Priority 3).
/// actorId is intentionally not a FK so audit history survives user deletion.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String?
  entityId  String?
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  passwordHash    String
  role            Role             @default(BUYER)
  approved        Boolean          @default(false)
  company         String?
  emailVerifiedAt DateTime?
  /// Last successful credential sign-in (Phase 3 M12). Powers "returning customers"
  /// analytics and the sales workspace's engagement view.
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  addresses       ShippingAddress[]
  contacts        ContactPerson[]
  quotes          Quote[]          @relation("buyerQuotes")
  assignedQuotes  Quote[]          @relation("assignedQuotes")
  sampleRequests  SampleRequest[]  @relation("buyerSamples")
  assignedSamples SampleRequest[]  @relation("assignedSamples")
  swatchItems     SwatchBookItem[]
  dealerProfile   DealerProfile?
  favourites      Favourite[]
  collections     Collection[]
  recentlyViewed  RecentlyViewed[]
  downloads       Download[]
}

/// Dealer/buyer profile: company, shipping, GST, and communication preferences (Priority 6).
model DealerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company         String?
  contactPhone    String?
  whatsapp        String?
  gstNumber       String?
  /// VAT / tax identifier for export customers (Phase 3 M12). GST covers India, VAT the rest.
  vatNumber       String?
  website         String?
  shippingLine1   String?
  shippingCity    String?
  shippingState   String?
  shippingPincode String?
  shippingCountry String?  @default("India")
  prefEmail       Boolean  @default(true)
  prefWhatsapp    Boolean  @default(true)
  prefPhone       Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

/// A customer's book of delivery addresses (Phase 3 M12). The single address on
/// `DealerProfile` stays as the profile's primary and is migrated in as the first entry;
/// sample and quote flows read the default address from here.
model ShippingAddress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String   @default("Delivery address")
  contactName String?
  phone       String?
  line1       String
  line2       String?
  city        String
  state       String?
  pincode     String?
  country     String   @default("India")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, isDefault])
}

/// Named people at the customer's company (Phase 3 M12) — merchandiser, accounts, logistics.
/// Sales addresses the right person instead of a generic company mailbox.
model ContactPerson {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  designation String?
  email       String?
  phone       String?
  whatsapp    String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, isPrimary])
}

model Favourite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fabricId  String
  fabric    Fabric   @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  colourId  String?
  colour    Colour?  @relation(fields: [colourId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, fabricId, colourId])
  @@index([userId])
}

model Collection {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime         @default(now())
  items     CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  fabricId     String
  fabric       Fabric     @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  colourId     String
  colour       Colour     @relation(fields: [colourId], references: [id], onDelete: Cascade)
  note         String?
  createdAt    DateTime   @default(now())

  @@unique([collectionId, fabricId, colourId])
}

model RecentlyViewed {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fabricId String
  fabric   Fabric   @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  colourId String?
  colour   Colour?  @relation(fields: [colourId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([userId, fabricId, colourId])
  @@index([userId, viewedAt])
}

model Download {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fabricId  String?
  fabric    Fabric?  @relation(fields: [fabricId], references: [id], onDelete: SetNull)
  colourId  String?
  kind      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITE
}

/// Single-use, expiring tokens for email verification, password reset, and invites
/// (Priority 4). Only the SHA-256 hash of the token is stored; the raw value lives only
/// in the emailed link.
model Token {
  id            String    @id @default(cuid())
  type          TokenType
  tokenHash     String    @unique
  email         String
  userId        String?
  role          Role?
  invitedByName String?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([email, type])
}

model Fabric {
  id          String           @id
  name        String
  family      String
  weight      String
  width       String
  comp        String
  nc          Int
  hand        String
  sheen       Float
  flow        Float
  stretch     Float
  seed        Int
  price       Int
  heroIndex   Int
  colours         Colour[]
  media           Media[]
  quoteItems      QuoteItem[]
  swatchItems     SwatchBookItem[]
  favourites      Favourite[]
  collectionItems CollectionItem[]
  recentlyViewed  RecentlyViewed[]
  downloads       Download[]
  sampleItems     SampleItem[]
}

model Colour {
  id          String           @id @default(cuid())
  fabricId    String
  fabric      Fabric           @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  name        String
  // Canonical colour definition (OKLCH).
  l           Float
  c           Float
  h           Float
  order       Int
  // Derived colour intelligence (Priority 9). Nullable so rows exist before backfill.
  hex           String?
  rgbR          Int?
  rgbG          Int?
  rgbB          Int?
  labL          Float?
  labA          Float?
  labB          Float?
  brightness    Float?
  saturation    Float?
  temperature   String?
  contrastInk   Float?
  contrastCream Float?
  /// Reserved extension point for future AI / vector similarity search (unused for now).
  colourVector  Json?

  media           Media[]
  quoteItems      QuoteItem[]
  swatchItems     SwatchBookItem[]
  relationsFrom   ColourRelationship[] @relation("relationFrom")
  relationsTo     ColourRelationship[] @relation("relationTo")
  favourites      Favourite[]
  collectionItems CollectionItem[]
  recentlyViewed  RecentlyViewed[]
  sampleItems     SampleItem[]

  @@unique([fabricId, order])
  @@index([fabricId])
  @@index([temperature])
}

enum ColourRelationKind {
  SIMILAR
  COMPLEMENTARY
  ANALOGOUS
}

/// Precomputed colour relationships (Priority 9). Powers "similar shades" and prepares
/// future AI-assisted discovery. Ranked by CIELAB ΔE / hue distance.
model ColourRelationship {
  id           String             @id @default(cuid())
  fromColourId String
  fromColour   Colour             @relation("relationFrom", fields: [fromColourId], references: [id], onDelete: Cascade)
  toColourId   String
  toColour     Colour             @relation("relationTo", fields: [toColourId], references: [id], onDelete: Cascade)
  kind         ColourRelationKind
  distance     Float
  rank         Int

  @@unique([fromColourId, toColourId, kind])
  @@index([fromColourId, kind, rank])
}

model Media {
  id                String     @id @default(cuid())
  fabricId          String
  fabric            Fabric     @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  colourId          String?
  colour            Colour?    @relation(fields: [colourId], references: [id], onDelete: SetNull)
  type              MediaType  @default(IMAGE)
  originalName      String
  originalSizeBytes Int
  mimeType          String
  storagePath       String
  webpPath          String?
  avifPath          String?
  thumbPath         String?
  width             Int?
  height            Int?
  qrDataUrl         String?
  aiColourName      String?
  aiConfidence      Int?
  aiSource          String?
  stage             MediaStage @default(QUEUED)
  // Storage-layer metadata (Priority 1). storageKey is the provider-agnostic object key;
  // *Path columns keep holding the same keys for backward compatibility.
  version           Int        @default(1)
  storageKey        String?
  checksum          String?
  etag              String?
  metadata          Json?
  /// Dominant colour palette extracted from the uploaded image (Priority 9).
  dominantPalette   Json?
  // Content lifecycle (Priority 11): draft/publish/archive + reversible soft delete.
  contentStatus     ContentStatus @default(PUBLISHED)
  publishedAt       DateTime?
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())

  @@index([fabricId])
  @@index([storageKey])
  @@index([contentStatus])
  @@index([deletedAt])
  @@index([createdAt])
}

/// Search query log (Priority 10). Powers per-user "recent" and aggregate "popular"
/// searches. `normalized` is the lowercased/trimmed query for grouping.
model SearchQuery {
  id          String   @id @default(cuid())
  query       String
  normalized  String
  userId      String?
  resultCount Int
  createdAt   DateTime @default(now())

  @@index([normalized])
  @@index([userId, createdAt])
  @@index([createdAt])
}

enum QuoteStatus {
  NEW
  ASSIGNED
  QUOTED
  WON
  LOST
}

model Quote {
  id             String       @id @default(cuid())
  userId         String?
  user           User?        @relation("buyerQuotes", fields: [userId], references: [id], onDelete: SetNull)
  name           String
  company        String
  quantity       String
  subject        String
  // Inquiry details (Priority 7).
  email          String?
  moq            String?
  expectedQty    String?
  country        String?
  shippingMethod String?
  timeline       String?
  message        String?
  status         QuoteStatus  @default(NEW)
  assigneeId     String?
  assignee       User?        @relation("assignedQuotes", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          QuoteItem[]
  events         QuoteEvent[]

  @@index([status])
  @@index([assigneeId])
  @@index([userId])
  @@index([createdAt])
}

/// Immutable timeline of a quote: status changes, assignments, and notes (Priority 7).
model QuoteEvent {
  id         String       @id @default(cuid())
  quoteId    String
  quote      Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  type       String // STATUS | ASSIGN | NOTE | CREATED
  fromStatus QuoteStatus?
  toStatus   QuoteStatus?
  note       String?
  actorId    String?
  createdAt  DateTime     @default(now())

  @@index([quoteId, createdAt])
}

model QuoteItem {
  id       String @id @default(cuid())
  quoteId  String
  quote    Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  fabricId String
  fabric   Fabric @relation(fields: [fabricId], references: [id])
  colourId String
  colour   Colour @relation(fields: [colourId], references: [id])
}

enum SampleStatus {
  REQUESTED
  APPROVED
  DISPATCHED
  DELIVERED
  REJECTED
}

/// Physical swatch/sample dispatch workflow (Priority 8).
model SampleRequest {
  id              String        @id @default(cuid())
  userId          String?
  user            User?         @relation("buyerSamples", fields: [userId], references: [id], onDelete: SetNull)
  name            String
  company         String
  email           String?
  phone           String?
  shippingLine1   String
  shippingCity    String
  shippingState   String?
  shippingPincode String?
  shippingCountry String        @default("India")
  message         String?
  status          SampleStatus  @default(REQUESTED)
  courier         String?
  trackingNumber  String?
  assigneeId      String?
  assignee        User?         @relation("assignedSamples", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           SampleItem[]
  events          SampleEvent[]

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

model SampleItem {
  id       String        @id @default(cuid())
  sampleId String
  sample   SampleRequest @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  fabricId String
  fabric   Fabric        @relation(fields: [fabricId], references: [id])
  colourId String
  colour   Colour        @relation(fields: [colourId], references: [id])
}

/// Immutable history of a sample request: approval, dispatch, courier updates (Priority 8).
model SampleEvent {
  id         String        @id @default(cuid())
  sampleId   String
  sample     SampleRequest @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  type       String // CREATED | STATUS | COURIER | NOTE
  fromStatus SampleStatus?
  toStatus   SampleStatus?
  note       String?
  actorId    String?
  createdAt  DateTime      @default(now())

  @@index([sampleId, createdAt])
}

model SwatchBookItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fabricId  String
  fabric    Fabric   @relation(fields: [fabricId], references: [id])
  colourId  String
  colour    Colour   @relation(fields: [colourId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, fabricId, colourId])
}
