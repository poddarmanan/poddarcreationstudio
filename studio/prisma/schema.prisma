// Poddar Creation Studio — data model
// Ported from the approved Claude Design prototype (fabric/colour system, swatch book,
// quotes) plus the real backend the user asked for on top of it (auth, uploads/pipeline).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  SALES
  VIEWER
  BUYER
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaStage {
  QUEUED
  COMPRESSING
  NAMING
  THUMBNAIL
  QR
  PUBLISHED
}

/// Immutable record of privileged / state-changing actions (Priority 3).
/// actorId is intentionally not a FK so audit history survives user deletion.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String?
  entityId  String?
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  passwordHash    String
  role            Role             @default(BUYER)
  approved        Boolean          @default(false)
  company         String?
  emailVerifiedAt DateTime?
  createdAt       DateTime         @default(now())
  quotes          Quote[]
  swatchItems     SwatchBookItem[]
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITE
}

/// Single-use, expiring tokens for email verification, password reset, and invites
/// (Priority 4). Only the SHA-256 hash of the token is stored; the raw value lives only
/// in the emailed link.
model Token {
  id            String    @id @default(cuid())
  type          TokenType
  tokenHash     String    @unique
  email         String
  userId        String?
  role          Role?
  invitedByName String?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([email, type])
}

model Fabric {
  id          String           @id
  name        String
  family      String
  weight      String
  width       String
  comp        String
  nc          Int
  hand        String
  sheen       Float
  flow        Float
  stretch     Float
  seed        Int
  price       Int
  heroIndex   Int
  colours     Colour[]
  media       Media[]
  quoteItems  QuoteItem[]
  swatchItems SwatchBookItem[]
}

model Colour {
  id          String           @id @default(cuid())
  fabricId    String
  fabric      Fabric           @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  name        String
  // Canonical colour definition (OKLCH).
  l           Float
  c           Float
  h           Float
  order       Int
  // Derived colour intelligence (Priority 9). Nullable so rows exist before backfill.
  hex           String?
  rgbR          Int?
  rgbG          Int?
  rgbB          Int?
  labL          Float?
  labA          Float?
  labB          Float?
  brightness    Float?
  saturation    Float?
  temperature   String?
  contrastInk   Float?
  contrastCream Float?
  /// Reserved extension point for future AI / vector similarity search (unused for now).
  colourVector  Json?

  media          Media[]
  quoteItems     QuoteItem[]
  swatchItems    SwatchBookItem[]
  relationsFrom  ColourRelationship[] @relation("relationFrom")
  relationsTo    ColourRelationship[] @relation("relationTo")

  @@unique([fabricId, order])
  @@index([fabricId])
  @@index([temperature])
}

enum ColourRelationKind {
  SIMILAR
  COMPLEMENTARY
  ANALOGOUS
}

/// Precomputed colour relationships (Priority 9). Powers "similar shades" and prepares
/// future AI-assisted discovery. Ranked by CIELAB ΔE / hue distance.
model ColourRelationship {
  id           String             @id @default(cuid())
  fromColourId String
  fromColour   Colour             @relation("relationFrom", fields: [fromColourId], references: [id], onDelete: Cascade)
  toColourId   String
  toColour     Colour             @relation("relationTo", fields: [toColourId], references: [id], onDelete: Cascade)
  kind         ColourRelationKind
  distance     Float
  rank         Int

  @@unique([fromColourId, toColourId, kind])
  @@index([fromColourId, kind, rank])
}

model Media {
  id                String     @id @default(cuid())
  fabricId          String
  fabric            Fabric     @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  colourId          String?
  colour            Colour?    @relation(fields: [colourId], references: [id], onDelete: SetNull)
  type              MediaType  @default(IMAGE)
  originalName      String
  originalSizeBytes Int
  mimeType          String
  storagePath       String
  webpPath          String?
  avifPath          String?
  thumbPath         String?
  width             Int?
  height            Int?
  qrDataUrl         String?
  aiColourName      String?
  aiConfidence      Int?
  aiSource          String?
  stage             MediaStage @default(QUEUED)
  // Storage-layer metadata (Priority 1). storageKey is the provider-agnostic object key;
  // *Path columns keep holding the same keys for backward compatibility.
  version           Int        @default(1)
  storageKey        String?
  checksum          String?
  etag              String?
  metadata          Json?
  /// Dominant colour palette extracted from the uploaded image (Priority 9).
  dominantPalette   Json?
  createdAt         DateTime   @default(now())

  @@index([fabricId])
  @@index([storageKey])
}

/// Search query log (Priority 10). Powers per-user "recent" and aggregate "popular"
/// searches. `normalized` is the lowercased/trimmed query for grouping.
model SearchQuery {
  id          String   @id @default(cuid())
  query       String
  normalized  String
  userId      String?
  resultCount Int
  createdAt   DateTime @default(now())

  @@index([normalized])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model Quote {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  company   String
  quantity  String
  subject   String
  status    String      @default("received")
  createdAt DateTime    @default(now())
  items     QuoteItem[]
}

model QuoteItem {
  id       String @id @default(cuid())
  quoteId  String
  quote    Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  fabricId String
  fabric   Fabric @relation(fields: [fabricId], references: [id])
  colourId String
  colour   Colour @relation(fields: [colourId], references: [id])
}

model SwatchBookItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fabricId  String
  fabric    Fabric   @relation(fields: [fabricId], references: [id])
  colourId  String
  colour    Colour   @relation(fields: [colourId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, fabricId, colourId])
}
